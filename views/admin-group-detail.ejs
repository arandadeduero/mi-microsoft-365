<%- include('partials/header', { scripts: ['/js/confirm.js'] }) %>
<%
  const g = group;
  const base = '/admin/grupos/' + encodeURIComponent(g.id);
  const dateOf = function(v) { return v ? v.slice(0, 10) : '—'; };
%>

<main class="container py-4 page-shell page-error">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title"><%= g.displayName %></h1>
    <a href="/admin/grupos" class="btn btn-outline-secondary btn-sm">&larr; Volver a los grupos</a>
  </div>

  <% if (flash) { %><div class="alert alert-success" role="status"><%= flash %></div><% } %>
  <% if (errorMsg) { %><div class="alert alert-danger" role="alert"><%= errorMsg %></div><% } %>
  <% if (!g.manageable) { %><div class="alert alert-info" role="note"><strong><%= g.kind %>.</strong> <%= g.readOnlyReason %> Aquí solo se puede consultar.</div><% } %>

  <div class="row g-4">
    <div class="col-lg-5">
      <div class="card shadow-sm border-0 app-panel mb-4">
        <div class="card-body p-4">
          <h2 class="h5 mb-3">Datos</h2>
          <% if (g.manageable) { %>
          <form action="<%= base %>" method="POST" class="vstack gap-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <div>
              <label for="displayName" class="form-label">Nombre</label>
              <input type="text" id="displayName" name="displayName" value="<%= g.displayName %>" class="form-control" maxlength="256" required>
            </div>
            <div>
              <label for="description" class="form-label">Descripción</label>
              <textarea id="description" name="description" rows="2" class="form-control" maxlength="1024"><%= g.description || '' %></textarea>
            </div>
            <% if (g.isUnified && visibilities[g.visibility]) { %>
            <div>
              <label for="visibility" class="form-label">Visibilidad</label>
              <select id="visibility" name="visibility" class="form-select">
                <% Object.keys(visibilities).forEach(function(v) { %>
                  <option value="<%= v %>" <%= g.visibility === v ? 'selected' : '' %>><%= visibilities[v] %></option>
                <% }); %>
              </select>
            </div>
            <% } %>
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
          </form>
          <hr>
          <% } %>
          <dl class="row small mb-0">
            <dt class="col-5">Tipo</dt><dd class="col-7"><%= g.kind %><% if (g.hasTeam) { %> · con equipo de Teams<% } %></dd>
            <% if (!g.manageable) { %>
              <dt class="col-5">Descripción</dt><dd class="col-7"><%= g.description || '—' %></dd>
            <% } %>
            <dt class="col-5">Correo</dt><dd class="col-7"><%= g.mail || '—' %></dd>
            <dt class="col-5">Alias</dt><dd class="col-7"><%= g.mailNickname || '—' %></dd>
            <% if (g.visibility) { %><dt class="col-5">Visibilidad</dt><dd class="col-7"><%= g.visibility === 'Public' ? 'Público' : 'Privado' %></dd><% } %>
            <dt class="col-5">Creado</dt><dd class="col-7"><%= dateOf(g.createdDateTime) %></dd>
            <% if (g.expirationDateTime) { %>
              <dt class="col-5">Caduca</dt><dd class="col-7"><%= dateOf(g.expirationDateTime) %> (renovado: <%= dateOf(g.renewedDateTime) %>)</dd>
            <% } %>
            <% if (g.classification) { %><dt class="col-5">Clasificación</dt><dd class="col-7"><%= g.classification %></dd><% } %>
            <% if (g.membershipRule) { %>
              <dt class="col-5">Regla</dt><dd class="col-7"><code><%= g.membershipRule %></code> (<%= g.membershipRuleProcessingState || '—' %>)</dd>
            <% } %>
            <% if (g.onPremisesSyncEnabled) { %><dt class="col-5">Origen</dt><dd class="col-7">Sincronizado desde un directorio local</dd><% } %>
            <dt class="col-5">Identificador</dt><dd class="col-7"><code class="small"><%= g.id %></code></dd>
          </dl>
        </div>
      </div>

      <div class="card shadow-sm border-0 app-panel">
        <div class="card-body p-4">
          <h2 class="h5 mb-3">Propietarios (<%= owners.length %>)</h2>
          <% if (owners.length === 1) { %><p class="small text-warning-emphasis">Solo hay un propietario: si se va, el grupo se queda sin nadie que lo gestione.</p><% } %>
          <% if (owners.length === 0) { %><p class="text-muted small">Sin propietarios (o no se pueden leer).</p><% } %>
          <ul class="list-group list-group-flush mb-3">
            <% owners.forEach(function(o) { %>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span><%= o.displayName %><br><span class="text-muted small"><%= o.mail || o.userPrincipalName || '' %></span></span>
                <% if (g.manageable) { %>
                <form action="<%= base %>/propietarios/<%= encodeURIComponent(o.id) %>/quitar" method="POST" data-confirm="¿Quitar a <%= o.displayName %> de los propietarios?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                  <button type="submit" class="btn btn-outline-danger btn-sm">Quitar</button>
                </form>
                <% } %>
              </li>
            <% }); %>
          </ul>
          <% if (g.manageable) { %>
          <form action="<%= base %>/propietarios" method="POST" class="input-group">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <input type="email" name="user" class="form-control" placeholder="Correo del nuevo propietario" aria-label="Correo del nuevo propietario" required>
            <button type="submit" class="btn btn-outline-primary">Añadir</button>
          </form>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card shadow-sm border-0 app-panel">
        <div class="card-body p-4">
          <h2 class="h5 mb-3">Miembros (<%= members.length %>)</h2>
          <p class="text-muted small">Se listan las personas; los grupos anidados no aparecen.</p>
          <% if (g.manageable) { %>
          <form action="<%= base %>/miembros" method="POST" class="input-group mb-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <input type="email" name="user" class="form-control" placeholder="Correo de la persona a añadir" aria-label="Correo de la persona a añadir" required>
            <button type="submit" class="btn btn-outline-primary">Añadir miembro</button>
          </form>
          <details class="mb-3">
            <summary class="small">Añadir varias personas a la vez</summary>
            <form action="<%= base %>/miembros/lote/vista-previa" method="POST" class="mt-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
              <label for="addresses" class="form-label small">Pega los correos, uno por línea (vale una columna copiada de Excel, o separados por comas o punto y coma)</label>
              <textarea id="addresses" name="addresses" rows="6" class="form-control mb-2" placeholder="ana@arandadeduero.es&#10;luis@arandadeduero.es" required></textarea>
              <button type="submit" class="btn btn-outline-primary">Revisar antes de añadir</button>
            </form>
          </details>
          <% } %>
          <% if (members.length === 0) { %>
            <p class="text-muted mb-0">Este grupo no tiene miembros.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead><tr><th>Nombre</th><th>Correo</th><th>Tipo</th><% if (g.manageable) { %><th class="text-end">Acciones</th><% } %></tr></thead>
                <tbody>
                  <% members.forEach(function(m) { %>
                    <tr>
                      <td><a href="/admin/usuarios/<%= encodeURIComponent(m.id) %>"><%= m.displayName %></a></td>
                      <td><%= m.mail || m.userPrincipalName || '' %></td>
                      <td><%= m.userType === 'Guest' ? 'Invitado' : 'Miembro' %></td>
                      <% if (g.manageable) { %>
                      <td class="text-end">
                        <form action="<%= base %>/miembros/<%= encodeURIComponent(m.id) %>/quitar" method="POST" data-confirm="¿Quitar a <%= m.displayName %> del grupo?">
                          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                          <button type="submit" class="btn btn-outline-danger btn-sm">Quitar</button>
                        </form>
                      </td>
                      <% } %>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
