<%- include('partials/header', { scripts: ['/js/confirm.js', '/js/admin-users.js'] }) %>

<%
  const deptList = Array.isArray(departments) ? departments : [];
  const titleList = Array.isArray(jobTitles) ? jobTitles : [];
  const managers = Array.isArray(managersList) ? managersList : [];
  const groups = Array.isArray(allGroups) ? allGroups : [];
  const currentFilter = assignFilter || {};
  const filterType = currentFilter.filterType === 'jobTitle' ? 'jobTitle' : 'department';
  const filterValue = currentFilter.filterValue || '';
  const selectedGroupManagerId = (typeof groupManager !== 'undefined' && groupManager) ? groupManager.id : '';
  const selectedGroupTargetId = (typeof groupTarget !== 'undefined' && groupTarget) ? groupTarget.id : '';
%>

<main class="container py-4 page-shell page-error">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title">Responsables y grupos</h1>
  </div>

  <%- include('partials/admin-users-nav', { activeTab: 'responsables' }) %>

  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="alert alert-success" role="status"><%= flash %></div>
  <% } %>
  <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
    <div class="alert alert-danger" role="alert"><%= errorMsg %></div>
  <% } %>

  <!-- Sección 1: Asignar responsable en masa -->
  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h2 class="h5 mb-2">1. Asignar responsable en masa (por departamento o puesto)</h2>
      <p class="text-muted small mb-3">
        Busca todas las personas activas de un departamento o con un puesto concreto y asígnales el mismo responsable en el organigrama.
      </p>

      <form action="/admin/usuarios/responsables" method="GET" class="row g-3 align-items-end">
        <div class="col-md-4">
          <label for="filterType" class="form-label">Filtrar por</label>
          <select class="form-select" id="filterType" name="filterType" data-filter-type-toggle>
            <option value="department" <%= filterType === 'department' ? 'selected' : '' %>>Departamento</option>
            <option value="jobTitle" <%= filterType === 'jobTitle' ? 'selected' : '' %>>Puesto</option>
          </select>
        </div>

        <div class="col-md-5 <%= filterType === 'department' ? '' : 'd-none' %>" data-filter-type-group="department">
          <label for="filterValueDept" class="form-label">Departamento</label>
          <select class="form-select" id="filterValueDept" name="filterValue" <%= filterType === 'department' ? '' : 'disabled' %>>
            <option value="">— Selecciona un departamento —</option>
            <% deptList.forEach(function(dept) { %>
              <option value="<%= dept %>" <%= (filterType === 'department' && filterValue === dept) ? 'selected' : '' %>><%= dept %></option>
            <% }); %>
          </select>
        </div>

        <div class="col-md-5 <%= filterType === 'jobTitle' ? '' : 'd-none' %>" data-filter-type-group="jobTitle">
          <label for="filterValueTitle" class="form-label">Puesto</label>
          <select class="form-select" id="filterValueTitle" name="filterValue" <%= filterType === 'jobTitle' ? '' : 'disabled' %>>
            <option value="">— Selecciona un puesto —</option>
            <% titleList.forEach(function(jt) { %>
              <option value="<%= jt %>" <%= (filterType === 'jobTitle' && filterValue === jt) ? 'selected' : '' %>><%= jt %></option>
            <% }); %>
          </select>
        </div>

        <div class="col-md-3">
          <button type="submit" class="btn btn-primary">Buscar usuarios</button>
        </div>
      </form>

      <% if (typeof assignResult !== 'undefined' && assignResult) { %>
        <%
          const updCount = typeof assignResult.updated === 'number' ? assignResult.updated : (Array.isArray(assignResult.updated) ? assignResult.updated.length : 0);
          const failedList = Array.isArray(assignResult.failed) ? assignResult.failed : [];
        %>
        <div class="mt-3">
          <% if (updCount > 0) { %>
            <div class="alert alert-success" role="status">
              Responsable actualizado en <strong><%= updCount %></strong> <%= updCount === 1 ? 'cuenta' : 'cuentas' %>.
            </div>
          <% } %>
          <% if (failedList.length > 0) { %>
            <div class="alert alert-danger small" role="alert">
              <strong>No se pudo actualizar en <%= failedList.length %> <%= failedList.length === 1 ? 'cuenta' : 'cuentas' %>:</strong>
              <ul class="mb-0 mt-1">
                <% failedList.forEach(function(fItem) { %>
                  <li><%= typeof fItem === 'string' ? fItem : ((fItem.displayName || fItem.upn || fItem.userId || 'Usuario') + ': ' + (fItem.error || fItem.message || 'Error')) %></li>
                <% }); %>
              </ul>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (Array.isArray(assignMatched)) { %>
        <hr class="my-4">
        <% if (assignMatched.length === 0) { %>
          <p class="text-muted mb-0">No se han encontrado usuarios activos que coincidan con «<%= filterValue %>».</p>
        <% } else { %>
          <p class="text-muted small mb-3">
            Se han encontrado <strong><%= assignMatched.length %></strong> <%= assignMatched.length === 1 ? 'persona' : 'personas' %>.
          </p>
          <form
            action="/admin/usuarios/responsables/asignar"
            method="POST"
            data-confirm="¿Asignar este responsable a los usuarios seleccionados?"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <div class="table-responsive mb-3">
              <table class="table table-sm align-middle mb-0">
                <thead>
                  <tr>
                    <th style="width: 2rem;">
                      <input type="checkbox" class="form-check-input" data-check-all=".assign-mgr-cb" aria-label="Seleccionar todos" checked>
                    </th>
                    <th>Nombre</th>
                    <th>Usuario</th>
                    <th>Departamento</th>
                    <th>Puesto</th>
                    <th>Responsable actual</th>
                  </tr>
                </thead>
                <tbody>
                  <% assignMatched.forEach(function(u) { %>
                    <% const curMgr = typeof u.manager === 'string' ? u.manager : ((u.manager && u.manager.displayName) || u.managerName || ''); %>
                    <tr>
                      <td>
                        <input
                          type="checkbox"
                          class="form-check-input assign-mgr-cb"
                          name="userIds"
                          value="<%= u.id %>"
                          aria-label="Seleccionar a <%= u.displayName || u.userPrincipalName %>"
                          checked
                        >
                      </td>
                      <td>
                        <a href="/admin/usuarios/<%= encodeURIComponent(u.id) %>" class="text-decoration-none fw-semibold"><%= u.displayName || '—' %></a>
                      </td>
                      <td class="small text-muted"><%= u.userPrincipalName || u.mail || '—' %></td>
                      <td class="small"><%= u.department || '—' %></td>
                      <td class="small"><%= u.jobTitle || '—' %></td>
                      <td class="small text-muted"><%= curMgr || 'Sin responsable' %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <div class="row g-3 align-items-end">
              <div class="col-md-8">
                <label for="bulkManagerId" class="form-label">Nuevo responsable</label>
                <select class="form-select" id="bulkManagerId" name="managerId" required>
                  <option value="">— Selecciona un responsable —</option>
                  <% managers.forEach(function(m) { %>
                    <option value="<%= m.id %>">
                      <%= m.displayName %><% if (m.jobTitle) { %> — <%= m.jobTitle %><% } %><% if (m.userPrincipalName) { %> (<%= m.userPrincipalName %>)<% } %>
                    </option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-4">
                <button type="submit" class="btn btn-primary">Asignar responsable</button>
              </div>
            </div>
          </form>
        <% } %>
      <% } %>
    </div>
  </div>

  <!-- Sección 2: Añadir a un grupo según responsable -->
  <div class="card shadow-sm border-0 app-panel">
    <div class="card-body p-4">
      <h2 class="h5 mb-2">2. Añadir a un grupo según responsable</h2>
      <p class="text-muted small mb-3">
        Elige un responsable y un grupo para ver las personas que dependen directamente de él y añadir al grupo a quienes todavía no pertenecen.
      </p>

      <form action="/admin/usuarios/responsables" method="GET" class="row g-3 align-items-end">
        <div class="col-md-5">
          <label for="groupManagerId" class="form-label">Responsable</label>
          <select class="form-select" id="groupManagerId" name="managerId" required>
            <option value="">— Selecciona un responsable —</option>
            <% managers.forEach(function(m) { %>
              <option value="<%= m.id %>" <%= selectedGroupManagerId === m.id ? 'selected' : '' %>>
                <%= m.displayName %><% if (m.jobTitle) { %> — <%= m.jobTitle %><% } %><% if (m.userPrincipalName) { %> (<%= m.userPrincipalName %>)<% } %>
              </option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-5">
          <label for="targetGroupId" class="form-label">Grupo de destino</label>
          <select class="form-select" id="targetGroupId" name="groupId" required>
            <option value="">— Selecciona un grupo —</option>
            <% groups.forEach(function(g) { %>
              <option value="<%= g.id %>" <%= selectedGroupTargetId === g.id ? 'selected' : '' %>>
                <%= g.displayName || g.id %><% if (g.mail) { %> (<%= g.mail %>)<% } %>
              </option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary">Comprobar</button>
        </div>
      </form>

      <% if (typeof groupResult !== 'undefined' && groupResult) { %>
        <%
          const addedCount = typeof groupResult.added === 'number'
            ? groupResult.added
            : (Array.isArray(groupResult.added) ? groupResult.added.length : (typeof groupResult.updated === 'number' ? groupResult.updated : 0));
          const grpFailed = Array.isArray(groupResult.failed) ? groupResult.failed : (Array.isArray(groupResult.errors) ? groupResult.errors : []);
        %>
        <div class="mt-3">
          <% if (addedCount > 0) { %>
            <div class="alert alert-success" role="status">
              Se han añadido <strong><%= addedCount %></strong> <%= addedCount === 1 ? 'persona' : 'personas' %> al grupo.
            </div>
          <% } %>
          <% if (grpFailed.length > 0) { %>
            <div class="alert alert-danger small" role="alert">
              <strong>Errores al añadir al grupo (<%= grpFailed.length %>):</strong>
              <ul class="mb-0 mt-1">
                <% grpFailed.forEach(function(err) { %>
                  <li><%= typeof err === 'string' ? err : ((err.displayName || err.upn || err.userId || 'Usuario') + ': ' + (err.error || err.message || 'Error')) %></li>
                <% }); %>
              </ul>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (Array.isArray(groupReports)) { %>
        <%
          const toAdd = (typeof groupPreview !== 'undefined' && groupPreview && Array.isArray(groupPreview.toAdd)) ? groupPreview.toAdd : [];
          const alreadyIn = (typeof groupPreview !== 'undefined' && groupPreview && Array.isArray(groupPreview.alreadyIn)) ? groupPreview.alreadyIn : [];
          const alreadyIds = new Set(alreadyIn.map(function(u) { return u.id; }));
        %>
        <hr class="my-4">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
          <span class="text-muted small">
            Equipo de <strong><%= (groupManager && groupManager.displayName) || 'responsable' %></strong>
            para el grupo <strong><%= (groupTarget && groupTarget.displayName) || 'seleccionado' %></strong>:
          </span>
          <span class="badge bg-warning text-dark">Pendientes de añadir: <%= toAdd.length %></span>
          <span class="badge bg-success">Ya son miembros: <%= alreadyIn.length %></span>
        </div>

        <% if (groupReports.length === 0) { %>
          <p class="text-muted mb-0">Este responsable no tiene personas a cargo.</p>
        <% } else { %>
          <div class="table-responsive mb-3">
            <table class="table table-sm align-middle mb-0">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Usuario</th>
                  <th>Puesto</th>
                  <th>Grupos actuales</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                <% groupReports.forEach(function(rep) { %>
                  <%
                    const repGroups = Array.isArray(rep.groups) ? rep.groups : [];
                    const isMember = alreadyIds.has(rep.id);
                  %>
                  <tr>
                    <td>
                      <a href="/admin/usuarios/<%= encodeURIComponent(rep.id) %>" class="text-decoration-none fw-semibold"><%= rep.displayName || '—' %></a>
                    </td>
                    <td class="small text-muted"><%= rep.userPrincipalName || rep.mail || '—' %></td>
                    <td class="small"><%= rep.jobTitle || '—' %></td>
                    <td>
                      <% if (repGroups.length === 0) { %>
                        <span class="text-muted small">—</span>
                      <% } else { %>
                        <div class="d-flex flex-wrap gap-1">
                          <% repGroups.forEach(function(g) { %>
                            <span class="badge bg-light text-dark border fw-normal"><%= typeof g === 'string' ? g : (g.displayName || g.name || g.id) %></span>
                          <% }); %>
                        </div>
                      <% } %>
                    </td>
                    <td class="text-nowrap">
                      <% if (isMember) { %>
                        <span class="badge bg-success">Ya es miembro</span>
                      <% } else { %>
                        <span class="badge bg-warning text-dark">Se añadirá</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <% if (toAdd.length > 0) { %>
            <form
              action="/admin/usuarios/responsables/grupos"
              method="POST"
              data-confirm="¿Añadir estas personas al grupo seleccionado?"
            >
              <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
              <input type="hidden" name="managerId" value="<%= selectedGroupManagerId %>">
              <input type="hidden" name="groupId" value="<%= selectedGroupTargetId %>">

              <div class="border rounded p-3 mb-3">
                <div class="form-check border-bottom pb-2 mb-2">
                  <input type="checkbox" class="form-check-input" id="selectAllGroupAdd" data-check-all=".group-add-cb" checked>
                  <label class="form-check-label fw-semibold small" for="selectAllGroupAdd">Seleccionar todas las personas pendientes (<%= toAdd.length %>)</label>
                </div>
                <% toAdd.forEach(function(u) { %>
                  <div class="form-check">
                    <input
                      type="checkbox"
                      class="form-check-input group-add-cb"
                      name="userIds"
                      id="grpAdd-<%= u.id %>"
                      value="<%= u.id %>"
                      checked
                    >
                    <label class="form-check-label small" for="grpAdd-<%= u.id %>">
                      <strong><%= u.displayName || u.userPrincipalName %></strong>
                      <% if (u.userPrincipalName) { %><span class="text-muted">(<%= u.userPrincipalName %>)</span><% } %>
                    </label>
                  </div>
                <% }); %>
              </div>
              <button type="submit" class="btn btn-primary">Añadir al grupo</button>
            </form>
          <% } else { %>
            <div class="alert alert-success mb-0">Todas las personas del equipo ya pertenecen al grupo seleccionado.</div>
          <% } %>
        <% } %>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
