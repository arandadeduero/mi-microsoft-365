<%- include('partials/header') %>

<main class="container py-4 page-shell page-error">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title">Grupos</h1>
    <a href="/admin/grupos/nuevo" class="btn btn-primary">Nuevo grupo</a>
  </div>

  <% if (flash) { %><div class="alert alert-success" role="status"><%= flash %></div><% } %>
  <% if (errorMsg) { %><div class="alert alert-danger" role="alert"><%= errorMsg %></div><% } %>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <p class="text-muted small mb-3">
        Un <strong>grupo de Microsoft 365</strong> tiene correo compartido, calendario y archivos, y puede tener un equipo de Teams.
        Un <strong>grupo de seguridad</strong> solo sirve para dar permisos a un conjunto de personas.
      </p>
      <form action="/admin/grupos" method="GET" class="row g-3 align-items-end">
        <div class="col-md-6">
          <label for="q" class="form-label">Buscar</label>
          <input type="search" id="q" name="q" value="<%= q %>" class="form-control" placeholder="Nombre, descripción o correo">
        </div>
        <div class="col-md-4">
          <label for="tipo" class="form-label">Tipo</label>
          <select id="tipo" name="tipo" class="form-select">
            <option value="">Todos</option>
            <% kinds.forEach(function(k) { %><option value="<%= k %>" <%= k === kind ? 'selected' : '' %>><%= k %></option><% }); %>
          </select>
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100">Filtrar</button></div>
      </form>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel">
    <div class="card-body p-4">
      <p class="text-muted small"><%= groups.length %> de <%= total %> grupos</p>
      <% if (groups.length === 0) { %>
        <p class="text-muted mb-0">Ningún grupo coincide.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead><tr><th>Nombre</th><th>Tipo</th><th>Correo</th><th>Creado</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
              <% groups.forEach(function(g) { %>
                <tr>
                  <td>
                    <strong><%= g.displayName %></strong>
                    <% if (g.description) { %><div class="text-muted small"><%= g.description %></div><% } %>
                  </td>
                  <td>
                    <%= g.kind %>
                    <% if (g.hasTeam) { %><span class="badge bg-info text-dark">Teams</span><% } %>
                    <% if (g.visibility) { %><span class="badge bg-secondary"><%= g.visibility === 'Public' ? 'Público' : 'Privado' %></span><% } %>
                  </td>
                  <td><%= g.mail || '—' %></td>
                  <td><%= g.createdDateTime ? g.createdDateTime.slice(0, 10) : '—' %></td>
                  <td class="text-end"><a href="/admin/grupos/<%= encodeURIComponent(g.id) %>" class="btn btn-outline-primary btn-sm">Ver</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
