<%- include('partials/header', { scripts: ['/js/confirm.js', '/js/admin-users.js'] }) %>

<%
  const managers = Array.isArray(managersList) ? managersList : [];
  const tzName = (typeof targetTimezone !== 'undefined' && targetTimezone) ? targetTimezone : 'Romance Standard Time';
  const rootUpnVal = (typeof orgRootUpn !== 'undefined' && orgRootUpn) ? orgRootUpn : '';
%>

<main class="container py-4 page-shell page-error">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title">Calidad de datos</h1>
  </div>

  <%- include('partials/admin-users-nav', { activeTab: 'calidad' }) %>

  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="alert alert-success" role="status"><%= flash %></div>
  <% } %>
  <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
    <div class="alert alert-danger" role="alert"><%= errorMsg %></div>
  <% } %>

  <!-- Sección 1: Normalizar puestos de trabajo (Sentence case) -->
  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
        <div>
          <h2 class="h5 mb-1">1. Normalizar puestos de trabajo (mayúsculas y minúsculas)</h2>
          <p class="text-muted small mb-0">Detecta puestos escritos en mayúsculas o con formato irregular y propone pasarlos a formato de frase respetando siglas.</p>
        </div>
        <a href="/admin/usuarios/calidad?section=puestos" class="btn btn-outline-primary flex-shrink-0">Buscar candidatos</a>
      </div>

      <% if (typeof jobTitleResult !== 'undefined' && jobTitleResult) { %>
        <%
          const jtUpdated = typeof jobTitleResult.updated === 'number' ? jobTitleResult.updated : (Array.isArray(jobTitleResult.updated) ? jobTitleResult.updated.length : 0);
          const jtFailed = Array.isArray(jobTitleResult.failed) ? jobTitleResult.failed : [];
        %>
        <% if (jtUpdated > 0) { %>
          <div class="alert alert-success" role="status">
            Se han normalizado <strong><%= jtUpdated %></strong> <%= jtUpdated === 1 ? 'puesto' : 'puestos' %>.
          </div>
        <% } %>
        <% if (jtFailed.length > 0) { %>
          <div class="alert alert-danger small" role="alert">
            <strong>No se pudieron actualizar <%= jtFailed.length %> puestos:</strong>
            <ul class="mb-0 mt-1">
              <% jtFailed.forEach(function(err) { %>
                <li><%= typeof err === 'string' ? err : ((err.displayName || err.upn || err.userId || 'Usuario') + ': ' + (err.error || err.message || 'Error')) %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>
      <% } %>

      <% if (Array.isArray(jobTitleCandidates)) { %>
        <hr class="my-3">
        <% if (jobTitleCandidates.length === 0) { %>
          <div class="alert alert-success mb-0" role="status">Todos los puestos están correctamente normalizados.</div>
        <% } else { %>
          <form
            action="/admin/usuarios/calidad/puestos"
            method="POST"
            data-confirm="¿Aplicar la normalización a los puestos seleccionados?"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <div class="table-responsive mb-3">
              <table class="table table-sm align-middle mb-0">
                <thead>
                  <tr>
                    <th style="width: 2rem;">
                      <input type="checkbox" class="form-check-input" data-check-all=".job-title-cb" aria-label="Seleccionar todos" checked>
                    </th>
                    <th>Persona</th>
                    <th>Usuario</th>
                    <th>Puesto actual</th>
                    <th>Puesto normalizado</th>
                  </tr>
                </thead>
                <tbody>
                  <% jobTitleCandidates.forEach(function(c) { %>
                    <tr>
                      <td>
                        <input
                          type="checkbox"
                          class="form-check-input job-title-cb"
                          name="userIds"
                          value="<%= c.id || c.userId %>"
                          aria-label="Seleccionar a <%= c.displayName || c.upn %>"
                          checked
                        >
                      </td>
                      <td>
                        <a href="/admin/usuarios/<%= encodeURIComponent(c.id || c.userId) %>" class="text-decoration-none fw-semibold"><%= c.displayName || '—' %></a>
                      </td>
                      <td class="small text-muted"><%= c.upn || c.userPrincipalName || '—' %></td>
                      <td class="small text-muted"><%= c.current || '—' %></td>
                      <td class="small fw-semibold"><%= c.fixed || '—' %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <button type="submit" class="btn btn-primary">Aplicar cambios</button>
          </form>
        <% } %>
      <% } %>
    </div>
  </div>

  <!-- Sección 2: Reparar organigrama -->
  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h2 class="h5 mb-2">2. Reparar organigrama</h2>
      <p class="text-muted small mb-3">
        Comprueba que todas las personas activas cuelgan del nodo raíz del organigrama y detecta cuentas sin responsable, desconectadas de la raíz o con ciclos.
      </p>

      <form action="/admin/usuarios/calidad" method="GET" class="row g-3 align-items-end">
        <input type="hidden" name="section" value="organigrama">
        <div class="col-md-8">
          <label for="orgRootUpn" class="form-label">Usuario raíz del organigrama (UPN / correo)</label>
          <input type="text" class="form-control" id="orgRootUpn" name="rootUpn" value="<%= rootUpnVal %>" placeholder="alcaldia@...">
        </div>
        <div class="col-md-4">
          <button type="submit" class="btn btn-primary">Analizar organigrama</button>
        </div>
      </form>

      <% if (typeof orgResult !== 'undefined' && orgResult) { %>
        <div class="mt-3">
          <% if (orgResult.error) { %>
            <div class="alert alert-danger" role="alert"><%= orgResult.error %></div>
          <% } else { %>
            <div class="alert alert-success" role="status"><%= orgResult.message || 'Responsable actualizado correctamente.' %></div>
          <% } %>
        </div>
      <% } %>

      <% if (typeof orgAnalysis !== 'undefined' && orgAnalysis) { %>
        <%
          const noManager = Array.isArray(orgAnalysis.noManager) ? orgAnalysis.noManager : [];
          const wrongRoot = Array.isArray(orgAnalysis.wrongRoot) ? orgAnalysis.wrongRoot : [];
          const cycles = Array.isArray(orgAnalysis.cycles) ? orgAnalysis.cycles : [];
          const validCount = typeof orgAnalysis.validCount === 'number' ? orgAnalysis.validCount : 0;
          const orgGroups = [
            { title: 'Sin responsable asignado', badge: 'bg-warning text-dark', items: noManager },
            { title: 'No llegan al nodo raíz', badge: 'bg-warning text-dark', items: wrongRoot },
            { title: 'Ciclos detectados', badge: 'bg-danger', items: cycles },
          ];
          const totalOrgIssues = noManager.length + wrongRoot.length + cycles.length;
        %>
        <hr class="my-4">
        <% if (typeof orgRootUser !== 'undefined' && orgRootUser) { %>
          <p class="small text-muted mb-2">
            Nodo raíz: <strong><%= orgRootUser.displayName %></strong> (<%= orgRootUser.userPrincipalName || orgRootUser.mail || '' %>)
          </p>
        <% } %>
        <div class="d-flex flex-wrap gap-2 mb-3">
          <span class="badge bg-success">Correctos: <%= validCount %></span>
          <span class="badge bg-<%= noManager.length > 0 ? 'warning text-dark' : 'secondary' %>">Sin responsable: <%= noManager.length %></span>
          <span class="badge bg-<%= wrongRoot.length > 0 ? 'warning text-dark' : 'secondary' %>">Fuera de la raíz: <%= wrongRoot.length %></span>
          <span class="badge bg-<%= cycles.length > 0 ? 'danger' : 'secondary' %>">Ciclos: <%= cycles.length %></span>
        </div>

        <% if (totalOrgIssues === 0) { %>
          <div class="alert alert-success mb-0" role="status">El organigrama está completo y sin incidencias.</div>
        <% } else { %>
          <% orgGroups.forEach(function(grp) { %>
            <% if (grp.items.length > 0) { %>
              <h3 class="h6 mt-3 mb-2">
                <%= grp.title %>
                <span class="badge <%= grp.badge %> ms-1"><%= grp.items.length %></span>
              </h3>
              <div class="table-responsive mb-3">
                <table class="table table-sm align-middle mb-0">
                  <thead>
                    <tr>
                      <th>Persona</th>
                      <th>Departamento / Puesto</th>
                      <th>Asignar responsable</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% grp.items.forEach(function(item) { %>
                      <% const itemId = item.id || item.userId; %>
                      <tr>
                        <td>
                          <a href="/admin/usuarios/<%= encodeURIComponent(itemId) %>" class="text-decoration-none fw-semibold"><%= item.displayName || '—' %></a>
                          <div class="small text-muted"><%= item.userPrincipalName || item.upn || item.mail || '' %></div>
                        </td>
                        <td class="small text-muted">
                          <%= [item.department, item.jobTitle].filter(Boolean).join(' · ') || '—' %>
                        </td>
                        <td>
                          <form action="/admin/usuarios/calidad/organigrama" method="POST" class="d-flex gap-2 align-items-center">
                            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                            <input type="hidden" name="userId" value="<%= itemId %>">
                            <input type="hidden" name="rootUpn" value="<%= rootUpnVal %>">
                            <select name="managerId" class="form-select form-select-sm" aria-label="Responsable para <%= item.displayName || itemId %>" required>
                              <option value="">— Elegir responsable —</option>
                              <% managers.forEach(function(m) { %>
                                <% if (m.id !== itemId) { %>
                                  <option value="<%= m.id %>"><%= m.displayName %><% if (m.jobTitle) { %> — <%= m.jobTitle %><% } %></option>
                                <% } %>
                              <% }); %>
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm flex-shrink-0">Asignar</button>
                          </form>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          <% }); %>
        <% } %>
      <% } %>
    </div>
  </div>

  <!-- Sección 3: Zona horaria de buzones -->
  <div class="card shadow-sm border-0 app-panel">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
        <div>
          <h2 class="h5 mb-1">3. Zona horaria de buzones (<code><%= tzName %></code>)</h2>
          <p class="text-muted small mb-0">
            Comprueba <code>timeZone</code> y <code>workingHours.timeZone</code> en todos los buzones activos (además, el portal ya corrige automáticamente el buzón de cada persona cuando inicia sesión). Requiere el <strong>permiso de aplicación</strong> <code>MailboxSettings.ReadWrite</code> en Entra ID.
          </p>
        </div>
        <a href="/admin/usuarios/calidad?section=zona-horaria&runTz=1" class="btn btn-outline-primary flex-shrink-0">Auditar zonas horarias</a>
      </div>

      <% if (typeof tzResult !== 'undefined' && tzResult) { %>
        <%
          const tzUpdated = typeof tzResult.updated === 'number' ? tzResult.updated : (Array.isArray(tzResult.updated) ? tzResult.updated.length : 0);
          const tzFailed = Array.isArray(tzResult.failed) ? tzResult.failed : [];
        %>
        <% if (tzUpdated > 0) { %>
          <div class="alert alert-success" role="status">
            Se ha actualizado la zona horaria en <strong><%= tzUpdated %></strong> <%= tzUpdated === 1 ? 'buzón' : 'buzones' %>.
          </div>
        <% } %>
        <% if (tzFailed.length > 0) { %>
          <div class="alert alert-danger small" role="alert">
            <strong>No se pudieron actualizar <%= tzFailed.length %> buzones:</strong>
            <ul class="mb-0 mt-1">
              <% tzFailed.forEach(function(err) { %>
                <li><%= typeof err === 'string' ? err : ((err.displayName || err.upn || err.userId || 'Usuario') + ': ' + (err.error || err.message || 'Error')) %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>
      <% } %>

      <% if (typeof tzAudit !== 'undefined' && tzAudit) { %>
        <%
          const alreadyCorrect = Array.isArray(tzAudit.alreadyCorrect) ? tzAudit.alreadyCorrect : [];
          const needsUpdate = Array.isArray(tzAudit.needsUpdate) ? tzAudit.needsUpdate : [];
          const noMailbox = Array.isArray(tzAudit.noMailbox) ? tzAudit.noMailbox : [];
          const accessDenied = Array.isArray(tzAudit.accessDenied) ? tzAudit.accessDenied : [];
        %>
        <hr class="my-4">
        <div class="row g-3 mb-4">
          <div class="col-6 col-md-3">
            <div class="border rounded p-3 text-center">
              <div class="h4 mb-0 text-success"><%= alreadyCorrect.length %></div>
              <div class="small text-muted">Correctos</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="border rounded p-3 text-center">
              <div class="h4 mb-0 <%= needsUpdate.length > 0 ? 'text-warning-emphasis' : '' %>"><%= needsUpdate.length %></div>
              <div class="small text-muted">Por corregir</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="border rounded p-3 text-center">
              <div class="h4 mb-0 text-muted"><%= noMailbox.length %></div>
              <div class="small text-muted">Sin buzón</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="border rounded p-3 text-center">
              <div class="h4 mb-0 <%= accessDenied.length > 0 ? 'text-danger' : 'text-muted' %>"><%= accessDenied.length %></div>
              <div class="small text-muted">Sin acceso</div>
            </div>
          </div>
        </div>

        <% if (accessDenied.length > 0) { %>
          <div class="alert alert-warning small">
            <strong>Acceso denegado en <%= accessDenied.length %> <%= accessDenied.length === 1 ? 'cuenta' : 'cuentas' %>:</strong>
            En Microsoft Graph el permiso delegado <code>MailboxSettings.ReadWrite</code> solo permite abrir el buzón propio (<code>/me/mailboxSettings</code>). Para auditar y corregir los buzones de otras personas desde aquí, añade <code>MailboxSettings.ReadWrite</code> como <strong>Permiso de aplicación</strong> (no solo delegado) en el registro de la app en Entra ID y concédele consentimiento de administrador.
          </div>
        <% } %>

        <% if (needsUpdate.length > 0) { %>
          <form
            action="/admin/usuarios/calidad/zona-horaria"
            method="POST"
            data-confirm="¿Actualizar la zona horaria a <%= tzName %> en los buzones seleccionados?"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <div class="table-responsive mb-3">
              <table class="table table-sm align-middle mb-0">
                <thead>
                  <tr>
                    <th style="width: 2rem;">
                      <input type="checkbox" class="form-check-input" data-check-all=".tz-user-cb" aria-label="Seleccionar todos" checked>
                    </th>
                    <th>Persona</th>
                    <th>Usuario</th>
                    <th>Zona horaria actual</th>
                    <th>Zona horaria de horario laboral</th>
                  </tr>
                </thead>
                <tbody>
                  <% needsUpdate.forEach(function(u) { %>
                    <tr>
                      <td>
                        <input
                          type="checkbox"
                          class="form-check-input tz-user-cb"
                          name="userIds"
                          value="<%= u.id || u.userId %>"
                          aria-label="Seleccionar a <%= u.displayName || u.upn %>"
                          checked
                        >
                      </td>
                      <td>
                        <a href="/admin/usuarios/<%= encodeURIComponent(u.id || u.userId) %>" class="text-decoration-none fw-semibold"><%= u.displayName || '—' %></a>
                      </td>
                      <td class="small text-muted"><%= u.upn || u.userPrincipalName || '—' %></td>
                      <td class="small"><code><%= u.timeZone || u.currentTimeZone || '—' %></code></td>
                      <td class="small"><code><%= u.workingHoursTimeZone || u.workingHoursTz || '—' %></code></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <button type="submit" class="btn btn-primary">Corregir zona horaria</button>
          </form>
        <% } else if (accessDenied.length === 0) { %>
          <div class="alert alert-success mb-0" role="status">Todos los buzones comprobados tienen la zona horaria correcta.</div>
        <% } %>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
