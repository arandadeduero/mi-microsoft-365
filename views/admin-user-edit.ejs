<%- include('partials/header', { scripts: ['/js/confirm.js', '/js/admin-users.js'] }) %>

<%
  const u = user || {};
  const groupIdSet = new Set(Array.isArray(userGroupIds) ? userGroupIds : []);
  const groupsList = Array.isArray(allGroups) ? allGroups : [];
  const licenseList = Array.isArray(licenses) ? licenses : [];
  const managers = Array.isArray(managersList) ? managersList.filter(function(m) { return m.id !== u.id; }) : [];
  const hireDate = (u.employeeHireDate || '').slice(0, 10);
  const businessPhone = (Array.isArray(u.businessPhones) && u.businessPhones[0]) ? u.businessPhones[0] : '';
  const employeeTypes = ['Employee', 'Contractor', 'Consultant', 'Vendor'];
  const currentEmpType = u.employeeType || '';
  const hasCustomEmpType = currentEmpType && !employeeTypes.includes(currentEmpType);
  const enabledStr = u.accountEnabled === false ? 'false' : 'true';
  const encodedId = encodeURIComponent(u.id || '');
%>

<main class="container py-4 page-shell page-error">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h1 class="h2 mb-0 page-title"><%= u.displayName || 'Editar usuario' %></h1>
    </div>
    <a href="/admin/usuarios" class="btn btn-outline-secondary btn-sm">&larr; Volver al directorio</a>
  </div>

  <%- include('partials/admin-users-nav', { activeTab: 'directorio' }) %>

  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="alert alert-success" role="status"><%= flash %></div>
  <% } %>
  <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
    <div class="alert alert-danger" role="alert"><%= errorMsg %></div>
  <% } %>

  <% if (typeof resetResult !== 'undefined' && resetResult) { %>
    <div class="alert alert-success shadow-sm mb-4" role="status">
      <h2 class="h5 alert-heading mb-2">Contraseña temporal generada (se muestra una sola vez)</h2>
      <p class="mb-2">Entrégala a la persona por un canal seguro. Tendrá que cambiarla la primera vez que inicie sesión.</p>
      <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <code id="generatedPassword" class="fs-5 px-2 py-1 rounded bg-light text-dark border user-select-all"><%= resetResult.password %></code>
        <button type="button" class="btn btn-outline-success btn-sm" data-copy-target="#generatedPassword">Copiar contraseña</button>
        <% if (resetResult.outlookWebUrl) { %>
          <a href="<%= resetResult.outlookWebUrl %>" target="_blank" rel="noopener" class="btn btn-primary btn-sm">Abrir en Outlook Web</a>
        <% } %>
        <% if (resetResult.mailtoUrl) { %>
          <a href="<%= resetResult.mailtoUrl %>" class="btn btn-outline-primary btn-sm">Abrir en cliente de correo (mailto)</a>
        <% } %>
      </div>
      <% if (resetResult.body) { %>
        <label for="resetEmailBody" class="form-label small fw-semibold mb-1">Texto sugerido para el correo</label>
        <textarea id="resetEmailBody" class="form-control font-monospace small mb-2" readonly rows="5"><%= resetResult.body %></textarea>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-copy-target="#resetEmailBody">Copiar texto</button>
      <% } %>
    </div>
  <% } %>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center gap-4">
        <img
          src="<%= (typeof userPhoto !== 'undefined' && userPhoto) ? userPhoto : '/images/default-avatar.svg' %>"
          alt="<%= u.displayName || '' %>"
          width="72"
          height="72"
          class="profile-avatar profile-avatar-sm flex-shrink-0"
        >
        <div class="flex-grow-1">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <h2 class="h4 mb-0"><%= u.displayName || '(Sin nombre)' %></h2>
            <% if (u.isRoom) { %>
              <span class="badge bg-info text-dark">Sala de reuniones</span>
            <% } %>
            <% if (u.accountEnabled === false) { %>
              <span class="badge bg-danger">Cuenta deshabilitada</span>
            <% } else { %>
              <span class="badge bg-success">Cuenta activa</span>
            <% } %>
          </div>
          <p class="text-muted mb-2"><%= u.userPrincipalName || u.mail || '—' %></p>
          <div class="row g-2 small">
            <div class="col-sm-6 col-lg-3">
              <strong>Puesto:</strong> <%= u.jobTitle || '—' %>
            </div>
            <div class="col-sm-6 col-lg-3">
              <strong>Departamento:</strong> <%= u.department || '—' %>
            </div>
            <div class="col-sm-6 col-lg-3">
              <strong>Responsable:</strong> <%= (typeof manager !== 'undefined' && manager) ? (manager.displayName || manager.userPrincipalName) : 'Sin asignar' %>
            </div>
            <div class="col-sm-6 col-lg-3">
              <strong>ID de objeto:</strong> <code class="small"><%= u.id || '—' %></code>
            </div>
          </div>
          <% if (licenseList.length > 0) { %>
            <div class="d-flex flex-wrap align-items-center gap-1 mt-2">
              <strong class="small me-1">Licencias:</strong>
              <% licenseList.forEach(function(lic) { %>
                <span class="badge bg-secondary fw-normal"><%= typeof lic === 'string' ? lic : (lic.name || lic.skuPartNumber || lic.skuId) %></span>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <%
    const assignedSkuIds = new Set(licenseList.map(function(l) { return l.skuId; }));
    const skuChoices = Array.isArray(typeof availableSkus !== 'undefined' ? availableSkus : null)
      ? availableSkus.filter(function(s) { return !assignedSkuIds.has(s.skuId); })
      : null;
  %>
  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h2 class="h5 mb-2">Licencias</h2>
      <% if (u.accountEnabled === false && licenseList.length > 0) { %>
        <div class="alert alert-warning py-2" role="status">
          La cuenta está deshabilitada y todavía tiene licencias asignadas: ocupan plazas que se pueden liberar.
        </div>
      <% } %>
      <form action="/admin/usuarios/<%= encodedId %>/licencias" method="POST" data-confirm="¿Aplicar los cambios de licencias a <%= u.displayName || u.userPrincipalName %>?">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <h3 class="h6 text-uppercase text-muted border-bottom pb-2 mb-3">Asignadas</h3>
        <% if (licenseList.length === 0) { %>
          <p class="text-muted">Sin licencias.</p>
        <% } else { %>
          <p class="text-muted small">Marca las que quieras quitar.</p>
          <% licenseList.forEach(function(lic) { %>
            <div class="form-check mb-1">
              <input class="form-check-input" type="checkbox" name="removeSkuIds" value="<%= lic.skuId %>" id="remove-<%= lic.skuId %>">
              <label class="form-check-label" for="remove-<%= lic.skuId %>"><%= lic.name || lic.skuPartNumber || lic.skuId %></label>
            </div>
          <% }); %>
          <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="remove-all" data-check-all="input[name='removeSkuIds']">
            <label class="form-check-label small" for="remove-all">Marcar todas</label>
          </div>
        <% } %>

        <h3 class="h6 text-uppercase text-muted border-bottom pb-2 mt-4 mb-3">Añadir</h3>
        <% if (skuChoices === null) { %>
          <p class="text-muted mb-0">No se puede consultar qué licencias hay disponibles.</p>
        <% } else if (skuChoices.length === 0) { %>
          <p class="text-muted">No hay más licencias disponibles que no tenga ya.</p>
        <% } else { %>
          <% if (!u.usageLocation) { %>
            <p class="small text-warning">Esta persona no tiene «ubicación de uso» (por ejemplo ES); Microsoft la exige para asignar licencias. Se pondrá ES al guardar si añades alguna.</p>
          <% } %>
          <% skuChoices.forEach(function(sku) { %>
            <div class="form-check mb-1">
              <input class="form-check-input" type="checkbox" name="addSkuIds" value="<%= sku.skuId %>" id="add-<%= sku.skuId %>" <%= sku.left <= 0 ? 'disabled' : '' %>>
              <label class="form-check-label" for="add-<%= sku.skuId %>"><%= sku.name %> <span class="text-muted small">(<%= sku.left %> libres)</span></label>
            </div>
          <% }); %>
        <% } %>
        <button type="submit" class="btn btn-primary mt-3">Guardar licencias</button>
      </form>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <h2 class="h5 mb-3">Datos del usuario</h2>
      <form action="/admin/usuarios/<%= encodedId %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">

        <h3 class="h6 text-uppercase text-muted border-bottom pb-2 mb-3">Identidad</h3>
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label for="displayName" class="form-label">Nombre para mostrar</label>
            <input type="text" class="form-control" id="displayName" name="displayName" value="<%= u.displayName || '' %>">
          </div>
          <div class="col-md-6">
            <label for="givenName" class="form-label">Nombre</label>
            <input type="text" class="form-control" id="givenName" name="givenName" value="<%= u.givenName || '' %>">
          </div>
          <div class="col-md-6">
            <label for="surname" class="form-label">Apellidos</label>
            <input type="text" class="form-control" id="surname" name="surname" value="<%= u.surname || '' %>">
          </div>
        </div>

        <h3 class="h6 text-uppercase text-muted border-bottom pb-2 mb-3">Información laboral</h3>
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label for="jobTitle" class="form-label">Puesto</label>
            <input type="text" class="form-control" id="jobTitle" name="jobTitle" value="<%= u.jobTitle || '' %>">
          </div>
          <div class="col-md-6">
            <label for="department" class="form-label">Departamento</label>
            <input type="text" class="form-control" id="department" name="department" value="<%= u.department || '' %>">
          </div>
          <div class="col-md-6">
            <label for="companyName" class="form-label">Empresa / Entidad</label>
            <input type="text" class="form-control" id="companyName" name="companyName" value="<%= u.companyName || '' %>">
          </div>
          <div class="col-md-6">
            <label for="employeeId" class="form-label">ID de empleado</label>
            <input type="text" class="form-control" id="employeeId" name="employeeId" value="<%= u.employeeId || '' %>">
          </div>
          <div class="col-md-6">
            <label for="employeeType" class="form-label">Tipo de empleado</label>
            <select class="form-select" id="employeeType" name="employeeType">
              <option value="">Sin especificar</option>
              <% employeeTypes.forEach(function(empType) { %>
                <option value="<%= empType %>" <%= currentEmpType === empType ? 'selected' : '' %>><%= empType %></option>
              <% }); %>
              <% if (hasCustomEmpType) { %>
                <option value="<%= currentEmpType %>" selected><%= currentEmpType %></option>
              <% } %>
            </select>
          </div>
          <div class="col-md-6">
            <label for="employeeHireDate" class="form-label">Fecha de alta</label>
            <input type="date" class="form-control" id="employeeHireDate" name="employeeHireDate" value="<%= hireDate %>">
          </div>
        </div>

        <h3 class="h6 text-uppercase text-muted border-bottom pb-2 mb-3">Contacto</h3>
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <label for="mobilePhone" class="form-label">Teléfono móvil</label>
            <input type="text" class="form-control" id="mobilePhone" name="mobilePhone" value="<%= u.mobilePhone || '' %>">
          </div>
          <div class="col-md-4">
            <label for="businessPhone" class="form-label">Teléfono de empresa</label>
            <input type="text" class="form-control" id="businessPhone" name="businessPhone" value="<%= businessPhone %>">
          </div>
          <div class="col-md-4">
            <label for="officeLocation" class="form-label">Ubicación de oficina</label>
            <input type="text" class="form-control" id="officeLocation" name="officeLocation" value="<%= u.officeLocation || '' %>">
          </div>
        </div>

        <h3 class="h6 text-uppercase text-muted border-bottom pb-2 mb-3">Dirección</h3>
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label for="streetAddress" class="form-label">Calle</label>
            <input type="text" class="form-control" id="streetAddress" name="streetAddress" value="<%= u.streetAddress || '' %>">
          </div>
          <div class="col-md-6">
            <label for="city" class="form-label">Localidad</label>
            <input type="text" class="form-control" id="city" name="city" value="<%= u.city || '' %>">
          </div>
          <div class="col-md-4">
            <label for="state" class="form-label">Provincia</label>
            <input type="text" class="form-control" id="state" name="state" value="<%= u.state || '' %>">
          </div>
          <div class="col-md-4">
            <label for="postalCode" class="form-label">Código postal</label>
            <input type="text" class="form-control" id="postalCode" name="postalCode" value="<%= u.postalCode || '' %>">
          </div>
          <div class="col-md-4">
            <label for="country" class="form-label">País</label>
            <input type="text" class="form-control" id="country" name="country" value="<%= u.country || '' %>">
          </div>
        </div>

        <h3 class="h6 text-uppercase text-muted border-bottom pb-2 mb-3">Ajustes</h3>
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <label for="usageLocation" class="form-label">Ubicación de uso</label>
            <input type="text" class="form-control" id="usageLocation" value="<%= u.usageLocation || '' %>" placeholder="ES" disabled>
          </div>
          <div class="col-md-4">
            <label for="preferredLanguage" class="form-label">Idioma preferido</label>
            <input type="text" class="form-control" id="preferredLanguage" value="<%= u.preferredLanguage || '' %>" placeholder="es-ES" disabled>
          </div>
          <div class="col-md-4">
            <label for="accountEnabled" class="form-label">Estado de la cuenta</label>
            <select class="form-select" id="accountEnabled" name="accountEnabled">
              <option value="true" <%= enabledStr === 'true' ? 'selected' : '' %>>Cuenta habilitada</option>
              <option value="false" <%= enabledStr === 'false' ? 'selected' : '' %>>Cuenta deshabilitada</option>
            </select>
          </div>
        </div>

        <div>
          <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-lg-5">
      <div class="card shadow-sm border-0 app-panel h-100">
        <div class="card-body p-4">
          <h2 class="h5 mb-2">Responsable (Organigrama)</h2>
          <p class="text-muted small mb-3">
            Responsable actual:
            <strong><%= (typeof manager !== 'undefined' && manager) ? (manager.displayName || manager.userPrincipalName) : 'Sin responsable asignado' %></strong>
          </p>
          <form action="/admin/usuarios/<%= encodedId %>/responsable" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <div class="mb-3">
              <label for="managerId" class="form-label">Seleccionar responsable</label>
              <select class="form-select" id="managerId" name="managerId">
                <option value="">— Selecciona un responsable —</option>
                <% managers.forEach(function(m) { %>
                  <option value="<%= m.id %>" <%= (typeof manager !== 'undefined' && manager && manager.id === m.id) ? 'selected' : '' %>>
                    <%= m.displayName %><% if (m.jobTitle) { %> — <%= m.jobTitle %><% } %><% if (m.userPrincipalName) { %> (<%= m.userPrincipalName %>)<% } %>
                  </option>
                <% }); %>
              </select>
            </div>
            <button type="submit" class="btn btn-primary">Actualizar responsable</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card shadow-sm border-0 app-panel h-100">
        <div class="card-body p-4">
          <h2 class="h5 mb-2">Grupos</h2>
          <p class="text-muted small mb-3">Marca los grupos a los que debe pertenecer esta persona y guarda los cambios.</p>
          <form action="/admin/usuarios/<%= encodedId %>/grupos" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <div class="mb-3">
              <label for="filterGroupsInput" class="visually-hidden">Filtrar grupos</label>
              <input
                type="search"
                id="filterGroupsInput"
                class="form-control form-control-sm"
                placeholder="Filtrar grupos por nombre..."
                data-filter-list="#userGroupsList"
              >
            </div>
            <div id="userGroupsList" class="border rounded p-3 mb-3" style="max-height: 320px; overflow-y: auto;">
              <% if (groupsList.length === 0) { %>
                <p class="text-muted small mb-0">No hay grupos disponibles.</p>
              <% } else { %>
                <% groupsList.forEach(function(g) { %>
                  <div class="form-check" data-filter-item>
                    <input
                      class="form-check-input"
                      type="checkbox"
                      name="groupIds"
                      id="grp-<%= g.id %>"
                      value="<%= g.id %>"
                      <%= groupIdSet.has(g.id) ? 'checked' : '' %>
                    >
                    <label class="form-check-label" for="grp-<%= g.id %>">
                      <%= g.displayName || g.id %><% if (g.mail) { %> <span class="text-muted small">(<%= g.mail %>)</span><% } %>
                    </label>
                  </div>
                <% }); %>
              <% } %>
            </div>
            <button type="submit" class="btn btn-primary">Guardar pertenencia a grupos</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel">
    <div class="card-body p-4">
      <h2 class="h5 mb-2">Restablecer contraseña</h2>
      <p class="text-muted mb-3">
        Genera una contraseña temporal legible con formato <code>Palabra-NNNN-Palabra</code> y obliga a cambiarla en el próximo inicio de sesión (<code>forceChangePasswordNextSignIn</code>). También prepara un enlace de correo listo para enviarla.
      </p>
      <button
        type="button"
        class="btn btn-warning"
        data-bs-toggle="modal"
        data-bs-target="#resetPasswordModal"
      >Generar nueva contraseña temporal</button>
    </div>
  </div>

  <div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form action="/admin/usuarios/<%= encodedId %>/reset-password" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <div class="modal-header">
            <h2 class="modal-title fs-5" id="resetPasswordModalLabel">Confirmar restablecimiento de contraseña</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body">
            <div class="alert alert-warning mb-3">
              Vas a cambiar la contraseña de <strong><%= u.displayName || u.userPrincipalName || 'esta cuenta' %></strong>
              (<code class="small"><%= u.userPrincipalName || u.mail || u.id %></code>).
            </div>
            <p class="small text-muted mb-3">
              Su contraseña actual dejará de funcionar de inmediato y no podrá entrar hasta que reciba la nueva contraseña temporal (que tendrá que cambiar en su próximo inicio de sesión).
            </p>
            <div class="form-check">
              <input
                class="form-check-input"
                type="checkbox"
                id="confirmResetPasswordCheck"
                name="confirmReset"
                value="1"
                required
                data-enable-target="#confirmResetPasswordBtn"
              >
              <label class="form-check-label fw-semibold" for="confirmResetPasswordCheck">
                Entiendo que su contraseña actual dejará de funcionar ahora mismo
              </label>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-danger" id="confirmResetPasswordBtn" disabled>Sí, restablecer contraseña</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
