<%- include('partials/header') %>

<main class="container py-4 page-shell">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title">Mis calendarios</h1>
    <div class="d-flex gap-2">
      <a href="/salas" class="btn btn-outline-secondary">Buscar una sala libre</a>
      <a href="/account" class="btn btn-outline-secondary">Volver a mi cuenta</a>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel mb-4" id="compartido">
    <div class="card-body p-4">
      <h2 class="h5 mb-3">Quién puede ver mi calendario</h2>
      <% if (calendarNotice) { %>
        <div class="alert alert-success"><%= calendarNotice %></div>
      <% } %>
      <% if (!calendarSharing) { %>
        <p class="text-muted">No se ha podido comprobar con quién compartes tu calendario.</p>
      <% } else { %>
        <% const outsiders = calendarSharing.filter(entry => entry.external); %>
        <% if (outsiders.length > 0) { %>
          <div class="alert alert-warning">
            Tu calendario está compartido con personas de fuera del Ayuntamiento: <strong><%= outsiders.map(entry => entry.email).join(', ') %></strong>. Si no lo has hecho tú, quítales el acceso y avisa a Informática.
          </div>
        <% } %>
        <% if (calendarSharing.length > 0) { %>
          <p class="text-muted">Estas personas pueden ver tu calendario. Quien solo ve si estás libre u ocupado no ve con quién ni para qué.</p>
          <ul class="list-group list-group-flush mb-3">
            <% calendarSharing.forEach(function(entry) { %>
              <li class="list-group-item px-0 d-flex justify-content-between align-items-start gap-3">
                <div>
                  <strong><%= entry.who %></strong><% if (entry.email) { %> <span class="text-muted small"><%= entry.email %></span><% } %>
                  <% if (entry.canChange) { %> <span class="badge bg-warning text-dark">Puede hacer cambios</span><% } %>
                  <br><span class="text-muted small"><%= entry.access %></span>
                </div>
                <% if (entry.removable) { %>
                  <form action="/account/calendar/<%= encodeURIComponent(entry.id) %>/remove" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                    <button type="submit" class="btn btn-outline-danger btn-sm text-nowrap">Quitar acceso</button>
                  </form>
                <% } %>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p>Nadie más puede ver tu calendario.</p>
        <% } %>
      <% } %>
      <% if (calendarSharing) { %>
        <form action="/account/calendar/share" method="POST" class="row g-2 align-items-end mb-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <div class="col-md-5">
            <label for="shareEmail" class="form-label">Compartir con</label>
            <input type="email" class="form-control" id="shareEmail" name="email" placeholder="nombre@<%= domain %>" required>
          </div>
          <div class="col-md-5">
            <label for="shareRole" class="form-label">Qué puede ver</label>
            <select class="form-select" id="shareRole" name="role">
              <% Object.entries(calendarRoles).forEach(function([value, label]) { %>
                <option value="<%= value %>"><%= label %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">Compartir</button>
          </div>
        </form>
        <p class="text-muted small">Solo con personas del Ayuntamiento. Para compartirlo con alguien de fuera, o nombrar a un delegado, hazlo desde Outlook.</p>
      <% } %>
      <a href="https://outlook.office.com/calendar/options/calendar/SharedCalendars" target="_blank" rel="noopener" class="btn btn-outline-secondary">Gestionar en Outlook</a>
    </div>
  </div>

  <div class="card shadow-sm border-0 app-panel mb-4" id="conmigo">
    <div class="card-body p-4">
      <h2 class="h5 mb-3">Calendarios compartidos conmigo</h2>
      <% if (!calendars) { %>
        <p class="text-muted mb-0">No se han podido comprobar los calendarios compartidos contigo.</p>
      <% } else if (calendars.sharedWithMe.length > 0) { %>
        <p class="text-muted">Calendarios de otras personas o buzones que ya tienes añadidos en Outlook.</p>
        <ul class="list-group list-group-flush mb-3">
          <% calendars.sharedWithMe.forEach(function(cal) { %>
            <li class="list-group-item px-0">
              <strong><%= cal.name %></strong>
              <% if (cal.canEdit) { %> <span class="badge bg-warning text-dark">Puedes editar</span><% } %>
              <br>
              <span class="text-muted small">
                De <%= cal.ownerName %><% if (cal.ownerEmail && cal.ownerEmail.toLowerCase() !== cal.ownerName.toLowerCase()) { %> (<%= cal.ownerEmail %>)<% } %> · <%= cal.access %>
              </span>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p class="mb-2">No tienes ningún calendario compartido añadido en Outlook.</p>
      <% } %>
      <p class="text-muted small mb-3">Aquí aparecen los calendarios que alguien compartió contigo y ya aceptaste o añadiste en Outlook.</p>
      <a href="https://outlook.office.com/calendar/" target="_blank" rel="noopener" class="btn btn-outline-secondary">Abrir calendario en Outlook</a>
    </div>
  </div>

  <% if (calendars && calendars.own.length > 0) { %>
    <div class="card shadow-sm border-0 app-panel">
      <div class="card-body p-4">
        <h2 class="h5 mb-3">Mis calendarios propios</h2>
        <ul class="list-group list-group-flush mb-0">
          <% calendars.own.forEach(function(cal) { %>
            <li class="list-group-item px-0">
              <strong><%= cal.name %></strong>
              <% if (cal.isDefault) { %> <span class="badge bg-primary">Principal</span><% } %>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
