<%- include('partials/header') %>

<main class="container py-4 page-shell page-error">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h1 class="h2 mb-0 page-title" title="<%= license.code %>"><%= license.name %></h1>
    </div>
    <a href="/admin/licencias" class="btn btn-outline-secondary btn-sm">&larr; Volver a licencias</a>
  </div>

  <p class="text-muted">
    <strong><%= users.length %></strong> <%= users.length === 1 ? 'cuenta tiene' : 'cuentas tienen' %> asignada esta licencia
    (<%= license.used %> en uso de <%= license.total %> compradas, <%= license.left %> libres).
  </p>

  <div class="card shadow-sm border-0 app-panel">
    <div class="card-body p-4">
      <% if (users.length === 0) { %>
        <p class="text-muted mb-0">Ningún usuario tiene asignada esta licencia actualmente.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Usuario</th>
                <th>Puesto</th>
                <th>Departamento</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function(u) { %>
                <tr>
                  <td>
                    <a href="/admin/usuarios/<%= encodeURIComponent(u.id) %>" class="fw-semibold text-decoration-none"><%= u.displayName || '(Sin nombre)' %></a>
                    <% if (u.accountEnabled === false) { %>
                      <span class="badge bg-danger ms-1">Deshabilitada</span>
                    <% } %>
                  </td>
                  <td class="small text-muted"><%= u.userPrincipalName || u.mail || '—' %></td>
                  <td class="small"><%= u.jobTitle || '—' %></td>
                  <td class="small"><%= u.department || '—' %></td>
                  <td class="text-end">
                    <a href="/admin/usuarios/<%= encodeURIComponent(u.id) %>" class="btn btn-outline-primary btn-sm">Editar</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
