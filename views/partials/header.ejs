<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · <%= appName %> · <%= orgName %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" as="font" href="/vendor/fonts/outfit-latin.woff2" type="font/woff2" crossorigin>
  <script src="/js/theme.js"></script>
  <% if (typeof csrfMeta !== 'undefined' && csrfMeta) { %>
  <meta name="csrf-token" content="<%= csrfToken() %>">
  <% } %>

  <!-- Bootstrap 5 and the Outfit typeface are served by the app (public/vendor): pages load nothing from other servers -->
  <link rel="stylesheet" href="/vendor/bootstrap-5.3.3.min.css">

  <!-- Custom CSS (declares the typeface) -->
  <link rel="stylesheet" href="/css/custom.css">
  <% if (typeof currentPage === 'undefined' || currentPage !== 'login') { %>
  <script src="/vendor/bootstrap-5.3.3.bundle.min.js" defer></script>
  <% } %>
  <script src="/js/submit-loading.js" defer></script>
  <% if (typeof scripts !== 'undefined' && Array.isArray(scripts)) { %>
    <% scripts.forEach(function(src) { %>
  <script src="<%= src %>" defer></script>
    <% }); %>
  <% } %>
</head>
<body class="d-flex flex-column min-vh-100 app-shell">
  <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
    <div class="bg-danger text-white text-center py-1 fw-bold">
      ADMIN
    </div>
  <% } %>
  <% if (typeof serviceIssues !== 'undefined' && serviceIssues.length > 0) { %>
    <div class="alert alert-warning rounded-0 border-0 mb-0 py-2 text-center" role="status">
      <strong>Incidencia en Microsoft 365:</strong>
      <%= serviceIssues.slice(0, 3).map(issue => `${issue.service}: ${issue.title}`).join(' · ') %>
    </div>
  <% } %>
  <% if (typeof currentPage !== 'undefined' && currentPage !== 'login') { %>
  <%
    // Which group of the menu the page belongs to, and the exact page inside it
    const page = currentPage;
    const here = typeof currentPath !== 'undefined' ? currentPath : '';
    const me = typeof currentUser !== 'undefined' ? currentUser : null;
    const admin = typeof isAdmin !== 'undefined' && isAdmin;
    const groupClass = (...pages) => 'nav-link dropdown-toggle' + (pages.includes(page) ? ' active' : '');
    // `under`: the item stays active on every page below it (and on the paths listed in `also`)
    const itemClass = (href, { under = false, also = [] } = {}) => 'dropdown-item' + (here === href || also.includes(here) || (under && here.startsWith(href + '/')) ? ' active' : '');
  %>
  <nav class="navbar navbar-expand-lg app-nav border-bottom shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-semibold" href="/"><%= appName %></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mostrar navegación">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <a href="/" class="nav-link <%= page === 'profile' ? 'active' : '' %>">Perfil</a>
          </li>
          <li class="nav-item dropdown">
            <a href="/account" class="<%= groupClass('account') %>" role="button" data-bs-toggle="dropdown" aria-expanded="false">Mi cuenta</a>
            <ul class="dropdown-menu">
              <li><a class="<%= itemClass('/account') %>" href="/account">Resumen de la cuenta</a></li>
              <li><a class="<%= itemClass('/account/sign-ins') %>" href="/account/sign-ins">Mis inicios de sesión</a></li>
              <li><a class="<%= itemClass('/account/apps') %>" href="/account/apps">Aplicaciones con acceso</a></li>
              <li><a class="<%= itemClass('/account/sharing') %>" href="/account/sharing">Qué comparto fuera</a></li>
              <li><a class="<%= itemClass('/account/calendars') %>" href="/account/calendars">Mis calendarios</a></li>
              <% if (typeof hasSharedMailboxes !== 'undefined' && hasSharedMailboxes) { %>
              <li><a class="<%= itemClass('/account/mailboxes') %>" href="/account/mailboxes">Buzones compartidos</a></li>
              <% } %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="<%= itemClass('/profile/me/edit') %>" href="/profile/me/edit">Editar mi perfil</a></li>
              <li><a class="<%= itemClass('/profile/me/auto-reply') %>" href="/profile/me/auto-reply">Respuestas automáticas</a></li>
              <li><a class="<%= itemClass('/firma') %>" href="/firma">Mi firma de correo</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="<%= itemClass('/account/activity') %>" href="/account/activity">Mi actividad</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a href="/directorio" class="<%= groupClass('directory', 'organigrama') %>" role="button" data-bs-toggle="dropdown" aria-expanded="false">Personas</a>
            <ul class="dropdown-menu">
              <li><a class="<%= itemClass('/directorio') %>" href="/directorio">Directorio</a></li>
              <li><a class="<%= itemClass('/organigrama') %>" href="/organigrama">Organigrama</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="<%= itemClass('/equipo') %>" href="/equipo">Mi equipo y solicitudes</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a href="/groups" class="<%= groupClass('groups', 'teams') %>" role="button" data-bs-toggle="dropdown" aria-expanded="false">Grupos</a>
            <ul class="dropdown-menu">
              <li><a class="<%= itemClass('/account/groups') %>" href="/account/groups">Mis grupos</a></li>
              <li><a class="<%= itemClass('/groups') %>" href="/groups">Todos los grupos</a></li>
              <li><a class="<%= itemClass('/groups/requests') %>" href="/groups/requests">Mis solicitudes</a></li>
              <li><a class="<%= itemClass('/groups/owned') %>" href="/groups/owned">Grupos que administro</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="<%= itemClass('/teams') %>" href="/teams">Mis equipos de Teams</a></li>
            </ul>
          </li>
          <li class="nav-item">
            <a href="/salas" class="nav-link <%= page === 'rooms' ? 'active' : '' %>">Salas</a>
          </li>
          <% if (typeof canPublish !== 'undefined' && canPublish) { %>
          <li class="nav-item">
            <a href="/blog" class="nav-link <%= page === 'blog' ? 'active' : '' %>">Blog</a>
          </li>
          <% } %>
          <li class="nav-item">
            <a href="/ayuda" class="nav-link <%= page === 'help' ? 'active' : '' %>">Ayuda</a>
          </li>
          <% if (admin) { %>
          <li class="nav-item dropdown">
            <a href="/admin/usuarios" class="<%= groupClass('admin') %> nav-link-admin" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
            <ul class="dropdown-menu">
              <li><h6 class="dropdown-header">Personas y cuentas</h6></li>
              <li><a class="<%= itemClass('/admin/usuarios', { under: true }) %>" href="/admin/usuarios">Usuarios</a></li>
              <li><a class="<%= itemClass('/admin/grupos', { under: true }) %>" href="/admin/grupos">Grupos</a></li>
              <li><a class="<%= itemClass('/admin/grupos-distribucion') %>" href="/admin/grupos-distribucion">Listas de distribución</a></li>
              <li><a class="<%= itemClass('/admin/licencias', { under: true }) %>" href="/admin/licencias">Licencias</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><h6 class="dropdown-header">Día a día</h6></li>
              <li><a class="<%= itemClass('/admin/solicitudes') %>" href="/admin/solicitudes">Solicitudes pendientes</a></li>
              <li><a class="<%= itemClass('/admin/comisiones') %>" href="/admin/comisiones">Convocar una comisión</a></li>
              <li><a class="<%= itemClass('/admin/salas') %>" href="/admin/salas">Ocupación de salas</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><h6 class="dropdown-header">Supervisión</h6></li>
              <li><a class="<%= itemClass('/admin/avisos') %>" href="/admin/avisos">Avisos de Microsoft</a></li>
              <li><a class="<%= itemClass('/admin/auditoria') %>" href="/admin/auditoria">Auditoría</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><h6 class="dropdown-header">Portal</h6></li>
              <li><a class="<%= itemClass('/admin/ajustes') %>" href="/admin/ajustes">Ajustes</a></li>
            </ul>
          </li>
          <% } %>
        </ul>
        <ul class="navbar-nav align-items-lg-center gap-lg-2">
          <li class="nav-item">
            <button type="button" class="theme-toggle-btn my-2 my-lg-0" data-theme-toggle aria-label="Cambiar a modo oscuro" aria-pressed="false" title="Cambiar a modo oscuro">
              <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278"/>
              </svg>
              <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"/>
              </svg>
              <span class="d-lg-none" data-theme-label>Modo oscuro</span>
            </button>
          </li>
          <% if (me) { %>
          <li class="nav-item dropdown">
            <a href="/" class="nav-link dropdown-toggle" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false"><%= me.name %></a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><span class="dropdown-item-text text-muted small"><%= me.username %></span></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="<%= itemClass('/debug') %>" href="/debug">Datos técnicos</a></li>
              <li><a class="dropdown-item" href="/auth/logout">Cerrar sesión</a></li>
            </ul>
          </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>
  <% } %>
