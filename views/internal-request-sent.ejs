<%- include('partials/header') %>

<main class="container py-4 page-shell page-profile">
  <h1 class="h2 mb-4 page-title"><%= request.title %></h1>

  <div class="alert alert-info" role="status">
    <strong>Esto es una prueba.</strong> Tu petición está bien rellenada, pero <strong>todavía no se ha enviado a nadie</strong>. Esto es lo que se habría enviado.
  </div>

  <div class="card shadow-sm border-0 app-panel mb-4">
    <div class="card-body p-4">
      <p class="mb-3">De: <strong><%= who %></strong></p>
      <dl class="row mb-0">
        <% values.forEach(function(item) { %>
          <dt class="col-sm-4"><%= item[0] %></dt>
          <dd class="col-sm-8" style="white-space: pre-wrap;"><%= item[1] %></dd>
        <% }); %>
      </dl>
    </div>
  </div>

  <a href="/peticiones" class="btn btn-outline-secondary">Volver a peticiones</a>
</main>

<%- include('partials/footer') %>
