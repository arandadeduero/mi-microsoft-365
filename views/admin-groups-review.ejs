<%- include('partials/header') %>
<%
  const sections = [
    { title: 'Sin propietario', groups: review.noOwner, why: 'Nadie puede gestionarlos ni aprobar a quien pida entrar. Añade un propietario desde su ficha.', tone: 'danger' },
    { title: 'Con un solo propietario', groups: review.oneOwner, why: 'Si esa persona se va o cambia de puesto, el grupo se queda sin nadie. Conviene tener al menos dos.', tone: 'warning' },
    { title: 'Vacíos', groups: review.empty, why: 'No tienen ningún miembro. Puede que sobren, o que falte rellenarlos.', tone: 'secondary' },
  ];
%>

<main class="container py-4 page-shell page-error">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title">Grupos que necesitan atención</h1>
    <a href="/admin/grupos" class="btn btn-outline-secondary btn-sm">&larr; Volver a los grupos</a>
  </div>

  <p class="text-muted">
    Se revisan los <strong><%= total %></strong> grupos que se pueden gestionar desde el portal (Microsoft 365 y de seguridad); los dinámicos, los de Exchange y los sincronizados no.
    Se mira en el momento, así que al arreglar uno basta con recargar.
  </p>
  <% if (review.unknown > 0) { %>
    <div class="alert alert-secondary py-2 small" role="status">
      No se ha podido comprobar <%= review.unknown %> grupo<%= review.unknown === 1 ? '' : 's' %> (Microsoft no ha contestado): no aparece<%= review.unknown === 1 ? '' : 'n' %> abajo, pero eso no quiere decir que esté<%= review.unknown === 1 ? '' : 'n' %> bien.
    </div>
  <% } %>

  <% if (sections.every(function(section) { return section.groups.length === 0; })) { %>
    <div class="alert alert-success" role="status">Todos los grupos revisados tienen propietarios y miembros.</div>
  <% } %>

  <% sections.forEach(function(section) { %>
    <% if (section.groups.length > 0) { %>
      <div class="card shadow-sm border-0 app-panel mb-4">
        <div class="card-body p-4">
          <h2 class="h5"><%= section.title %> <span class="badge bg-<%= section.tone %>"><%= section.groups.length %></span></h2>
          <p class="text-muted small"><%= section.why %></p>
          <div class="table-responsive">
            <table class="table align-middle mb-0">
              <thead><tr><th>Nombre</th><th>Tipo</th><th>Correo</th><th class="text-end">Acciones</th></tr></thead>
              <tbody>
                <% section.groups.forEach(function(group) { %>
                  <tr>
                    <td><strong><%= group.displayName %></strong></td>
                    <td><%= group.kind %></td>
                    <td><%= group.mail || '—' %></td>
                    <td class="text-end"><a href="/admin/grupos/<%= encodeURIComponent(group.id) %>" class="btn btn-outline-primary btn-sm">Abrir</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% } %>
  <% }); %>
</main>

<%- include('partials/footer') %>
