<%- include('partials/header') %>

<main class="container py-4 page-shell page-error">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <h1 class="h2 mb-0 page-title">Usuarios · Cuentas que necesitan atención</h1>
  </div>

  <%- include('partials/admin-users-nav', { activeTab: 'atencion' }) %>

  <p class="text-muted">Lo que conviene revisar de vez en cuando. Se lee con el permiso de la propia aplicación, no con tu cuenta.</p>

  <% if (!review) { %>
    <div class="card shadow-sm border-0 app-panel"><div class="card-body p-4"><p class="text-muted mb-0">Ahora mismo no se pueden leer las cuentas.</p></div></div>
  <% } else { %>
    <p class="text-muted small"><%= review.total %> cuentas de personas<% if (review.guests > 0) { %> y <%= review.guests %> invitados externos<% } %>.</p>
    <%
      // What Graph's refusal means, so the fix is clear
      const signInsHints = {
        Authentication_RequestFromNonPremiumTenantOrB2CTenant: 'Microsoft no da el último inicio de sesión sin licencias Entra ID P1 o P2 en el tenant.',
        Authorization_RequestDenied: 'A la aplicación le falta el permiso de aplicación AuditLog.Read.All, con consentimiento de administrador.',
      };
      const signInsUnavailable = 'No se puede saber: ' + (signInsHints[signInsError] || 'el registro de inicios de sesión necesita Entra ID P1 y el permiso de aplicación AuditLog.Read.All.') + (signInsError ? ` (Graph responde ${signInsError}.)` : '');
      const sections = [
        ['Sin iniciar sesión en 14 días', review.idle, signInsUnavailable],
        ['Sin segundo factor', review.withoutMfa, 'No se puede saber: el informe de métodos de autenticación necesita Entra ID P1 y el permiso de aplicación UserAuthenticationMethod.Read.All.'],
        ['Contraseña caducada', review.expiredPassword, 'No se comprueba: no hay PASSWORD_MAX_AGE_DAYS configurado.'],
        ['Deshabilitadas con licencia', review.disabledWithLicense, null],
        ['Habilitadas sin licencia', review.enabledWithoutLicense, null],
      ];
      function parseIdleDays(note) {
        const m = /hace\s+(\d+)\s+días/i.exec(String(note || ''));
        return m ? Number(m[1]) : null;
      }
      function classifyNotePill(note) {
        const text = String(note || '');
        if (text === 'Nunca ha iniciado sesión') {
          return { cls: 'pill-note-never', label: text, bucket: 'never', days: Infinity };
        }
        const days = parseIdleDays(text);
        if (days !== null) {
          if (days > 90) {
            return { cls: 'pill-note-severe', label: '⚠️ ' + text, bucket: 'over90', days };
          }
          if (days > 60) {
            return { cls: 'pill-note-orange', label: text, bucket: 'over60', days };
          }
          if (days > 30) {
            return { cls: 'pill-note-yellow', label: text, bucket: 'over30', days };
          }
          if (days > 14) {
            return { cls: 'pill-note-white', label: text, bucket: 'over14', days };
          }
        }
        return { cls: 'pill-note-severe', label: '⚠️ ' + text, bucket: 'other', days: 0 };
      }

      const idleBuckets = [
        { key: 'never', title: 'Nunca han iniciado sesión', cls: 'pill-note-never', items: [] },
        { key: 'over90', title: 'Más de 90 días sin iniciar sesión', cls: 'pill-note-severe', items: [] },
        { key: 'over60', title: 'Más de 60 días sin iniciar sesión (61–90 días)', cls: 'pill-note-orange', items: [] },
        { key: 'over30', title: 'Más de 30 días sin iniciar sesión (31–60 días)', cls: 'pill-note-yellow', items: [] },
        { key: 'over14', title: 'Más de 14 días sin iniciar sesión (15–30 días)', cls: 'pill-note-white', items: [] },
      ];
      if (Array.isArray(review.idle)) {
        const byKey = new Map(idleBuckets.map(b => [b.key, b]));
        review.idle.forEach(function(person) {
          const pill = classifyNotePill(person.note);
          const target = byKey.get(pill.bucket) || byKey.get('over90');
          target.items.push({ person, pill });
        });
        idleBuckets.forEach(function(b) {
          if (b.key !== 'never') {
            b.items.sort(function(a, c) { return c.pill.days - a.pill.days; });
          }
        });
      }
    %>

    <div class="card shadow-sm border-0 app-panel mb-3">
      <div class="card-body p-4">
        <h2 class="h5 mb-3">Sin iniciar sesión en más de 14 días<% if (review.idle) { %> <span class="badge bg-secondary"><%= review.idle.length %></span><% } %></h2>
        <% if (!review.idle) { %>
          <p class="text-muted mb-0"><%= signInsUnavailable %></p>
        <% } else if (review.idle.length === 0) { %>
          <p class="text-muted mb-0">Ninguna.</p>
        <% } else { %>
          <div class="row g-3">
            <% idleBuckets.forEach(function(bucket) { %>
              <% if (bucket.items.length > 0) { %>
                <div class="col-12">
                  <div class="border rounded p-3">
                    <h3 class="h6 mb-2 d-flex align-items-center gap-2">
                      <span class="badge rounded-pill <%= bucket.cls %>"><%= bucket.title %></span>
                      <span class="badge bg-secondary"><%= bucket.items.length %></span>
                    </h3>
                    <ul class="mb-0">
                      <% bucket.items.forEach(function(entry) { %>
                        <% const person = entry.person; const pill = entry.pill; %>
                        <li class="mb-1">
                          <% if (person.id) { %>
                            <a href="/admin/usuarios/<%= encodeURIComponent(person.id) %>" class="fw-semibold text-decoration-none"><%= person.name %></a>
                          <% } else { %>
                            <strong><%= person.name %></strong>
                          <% } %>
                          <span class="text-muted small"><%= person.username %></span>
                          <span class="badge rounded-pill <%= pill.cls %> ms-1"><%= pill.label %></span>
                        </li>
                      <% }); %>
                    </ul>
                  </div>
                </div>
              <% } %>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>

    <% sections.slice(1).forEach(function([heading, list, unavailable]) { %>
      <div class="card shadow-sm border-0 app-panel mb-3">
        <div class="card-body p-4">
          <h2 class="h5 mb-2"><%= heading %><% if (list) { %> <span class="badge bg-secondary"><%= list.length %></span><% } %></h2>
          <% if (!list) { %>
            <p class="text-muted mb-0"><%= unavailable %></p>
          <% } else if (list.length === 0) { %>
            <p class="text-muted mb-0">Ninguna.</p>
          <% } else { %>
            <ul class="mb-0">
              <% list.forEach(function(person) { %>
                <% const pill = classifyNotePill(person.note); %>
                <li class="mb-1">
                  <% if (person.id) { %>
                    <a href="/admin/usuarios/<%= encodeURIComponent(person.id) %>" class="fw-semibold text-decoration-none"><%= person.name %></a>
                  <% } else { %>
                    <strong><%= person.name %></strong>
                  <% } %>
                  <span class="text-muted small"><%= person.username %></span>
                  <span class="badge rounded-pill <%= pill.cls %> ms-1"><%= pill.label %></span>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </div>
    <% }); %>
  <% } %>
</main>

<%- include('partials/footer') %>
